{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"types": [ "node" ]
	},
	"include": ["config/**/*.ts", "apps/**/tests/**/*.ts", "packages/**/*.ts"]
}
