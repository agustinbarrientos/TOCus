{
	"name": "tocus",
	"private": true,
	"description": "Pause before visiting addictive websites",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/agustinbarrientos/TOCus.git"
	},
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24.16.0 <25",
		"pnpm": ">=12.14.0 <13"
	},
	"scripts": {
		"store:assets": "node tools/store-assets/generate.mjs",
		"dev": "turbo run dev --parallel",
		"setup:browsers": "pnpm --filter @tocus/extension exec playwright install chromium firefox webkit",
		"setup:installed-browsers": "bash tools/installed-browsers/setup-linux.sh",
		"build": "turbo run build",
		"build:edge": "pnpm --filter @tocus/extension build:edge",
		"build:firefox": "pnpm --filter @tocus/extension build:firefox",
		"build:safari": "pnpm --filter @tocus/extension build:safari",
		"zip:chrome": "pnpm --filter @tocus/extension zip:chrome",
		"zip:edge": "pnpm --filter @tocus/extension zip:edge",
		"zip:firefox": "pnpm --filter @tocus/extension zip:firefox",
		"zip:safari": "pnpm --filter @tocus/extension zip:safari",
		"lint": "pnpm lint:scripts && pnpm lint:styles",
		"lint:scripts": "eslint . --max-warnings 0",
		"lint:styles": "stylelint \"apps/*/src/**/*.{css,scss}\" \"apps/extension/config/**/*.css\" \"packages/theme/**/*.{css,scss}\" \"packages/ui/src/**/*.{css,scss}\" \"tools/store-assets/**/*.css\"",
		"lint:fix": "pnpm lint:scripts --fix && pnpm lint:styles --fix",
		"locales:extract": "lingui extract --clean",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tests/visual/tsconfig.json --noEmit && turbo run typecheck",
		"test": "pnpm test:unit && pnpm test:build-contract && pnpm test:browser",
		"test:unit": "pnpm test:store-assets && vitest run --coverage --config config/vitest.config.ts --project unit",
		"test:build-contract": "pnpm build && pnpm build:edge && pnpm build:firefox && pnpm build:safari && vitest run --config config/vitest.config.ts --project build-contract && pnpm test:build-browser",
		"test:build-browser": "playwright test --config config/playwright-build.config.ts",
		"test:installed-extension": "playwright test --config config/playwright-installed-extension.config.ts",
		"test:installed-extension:linux": "bash tools/installed-browsers/run-linux.sh",
		"test:browser": "pnpm --filter @tocus/extension test:browser && pnpm test:ui",
		"test:ui": "playwright test --config config/playwright-ui.config.ts",
		"test:visual": "playwright test --config config/playwright-visual.config.ts",
		"test:visual:update": "playwright test --config config/playwright-visual.config.ts --project chromium-website --update-snapshots=all",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"test:store-assets": "node --test tools/store-assets/lib/*.test.mjs"
	},
	"devDependencies": {
		"@babel/core": "8.0.7",
		"@babel/plugin-proposal-decorators": "8.0.2",
		"@eslint/js": "10.0.1",
		"@lingui/babel-plugin-lingui-macro": "6.9.1",
		"@lingui/cli": "6.9.1",
		"@lingui/conf": "6.9.1",
		"@lingui/format-po": "6.9.1",
		"@lingui/message-utils": "6.9.1",
		"@lingui/vite-plugin": "6.9.1",
		"@playwright/test": "1.64.1",
		"@rolldown/plugin-babel": "0.2.4",
		"@types/node": "26.6.5",
		"@types/pngjs": "6.0.5",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "10.12.0",
		"eslint-plugin-astro": "3.2.1",
		"eslint-plugin-jsdoc": "65.3.6",
		"eslint-plugin-lingui": "0.16.0",
		"geckodriver": "8.0.0",
		"globals": "17.13.0",
		"pngjs": "7.0.0",
		"puppeteer-core": "25.14.0",
		"sass": "1.105.1",
		"stylelint": "17.16.0",
		"stylelint-config-standard-scss": "17.0.0",
		"turbo": "2.11.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vitest": "5.0.5"
	}
}
