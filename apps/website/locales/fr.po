msgid "100% private."
msgstr "100 % privé."

#: apps/website/src/localization/index.ts
msgid "10s pause"
msgstr "Pause de 10 s"

#: apps/website/src/localization/index.ts
msgid "5m browsing"
msgstr "5 min de navigation"

#: apps/website/src/localization/index.ts
msgid "A preview of the breathing pause."
msgstr "Un aperçu de la pause pour respirer."

#: apps/website/src/localization/index.ts
msgid "A short pause before the websites you choose."
msgstr "Une courte pause avant les sites que vous choisissez."

#: apps/website/src/localization/index.ts
msgid "A smiling capybara peeking over the browser"
msgstr "Un capybara souriant qui regarde par-dessus le navigateur"

#: apps/website/src/localization/index.ts
msgid "Add a pause to your browser."
msgstr "Ajoutez une pause à votre navigateur."

#: apps/website/src/localization/index.ts
msgid "Also available on"
