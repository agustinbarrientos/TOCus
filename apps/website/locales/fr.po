#: apps/website/src/localization/index.ts
msgid "10s pause"
msgstr "Pause de 10 s"

#: apps/website/src/localization/index.ts
msgid "5m browsing"
msgstr "5 min de navigation"

#: apps/website/src/localization/index.ts
msgid "A calmer way to browse"
msgstr "Une façon plus sereine de naviguer"

#: apps/website/src/localization/index.ts
msgid "Also available on"
msgstr "Aussi disponible pour"

#: apps/website/src/localization/index.ts
msgid "Check how much time you’ve saved"
msgstr "Voyez combien de temps vous avez gagné"

#: apps/website/src/localization/index.ts
msgid "Choose the days and hours TOCus is active."
msgstr "Choisissez les jours et les heures où TOCus est actif."

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "Bientôt disponible"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "Continuer"

#. Language-menu autonym. Keep this language name written in German.
#: apps/website/src/localization/index.ts
msgid "Deutsch"
msgstr "Deutsch"

#: apps/website/src/localization/index.ts
msgid "Download for"
msgstr "Télécharger pour"

#. Language-menu autonym. Keep this language name written in English.
#: apps/website/src/localization/index.ts
msgid "English"
msgstr "English"

#. Language-menu autonym for the tuteo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (tú)"
msgstr "Español (tú)"

#. Language-menu autonym for the voseo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (vos)"
msgstr "Español (vos)"

#. Language-menu autonym. Keep this language name written in French.
#: apps/website/src/localization/index.ts
msgid "Français"
msgstr "Français"

#: apps/website/src/localization/index.ts
msgid "It's 100% private"
msgstr "C’est 100% privé"

#. Language-menu autonym. Keep this language name written in Italian.
#: apps/website/src/localization/index.ts
msgid "Italiano"
msgstr "Italiano"

#: apps/website/src/localization/index.ts
msgid "It’s free and open source"
msgstr "C’est gratuit et open source"

#: apps/website/src/localization/index.ts
msgid "Made by"
msgstr "Créé par"

#: apps/website/src/localization/index.ts
msgid "Open a site"
msgstr "Ouvrez un site"

#: apps/website/src/localization/index.ts
msgid "Pause before visiting addictive websites"
msgstr "Faites une pause avant de visiter des sites web addictifs"

#: apps/website/src/localization/index.ts
msgid "If you feel like it, pick different days and times for each site."
msgstr "Si vous en avez envie, choisissez des jours et des horaires différents pour chaque site."

#. Language-menu autonym for Brazilian Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Brasil)"
msgstr "Português (Brasil)"

#. Language-menu autonym for European Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Portugal)"
msgstr "Português (Portugal)"

#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Confidentialité"

#: apps/website/src/localization/index.ts
msgid "Privacy policy"
msgstr "Politique de confidentialité"

#: apps/website/src/localization/index.ts
msgid "Set a schedule for each site"
msgstr "Définissez un horaire pour chaque site"

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Aller au contenu"

#: apps/website/src/localization/index.ts
msgid "Source code"
msgstr "Code source"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "TOCus ajoute une pause pour respirer aux sites web de votre choix."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus est une extension de navigateur open source."

#: apps/website/src/localization/index.ts
msgid "Take a moment to pause."
msgstr "Prenez un moment pour faire une pause."

#: apps/website/src/localization/index.ts
msgid "Use it only when you want to"
msgstr "Utilisez-le seulement quand vous le souhaitez"

#: apps/website/src/localization/index.ts
msgid "Videos pause while you wait and resume when you’re ready."
msgstr "Les vidéos se mettent en pause pendant l’attente et reprennent quand vous souhaitez continuer."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Voir le code source"

#: apps/website/src/localization/index.ts
msgid "View your completed pauses and visits you changed your mind about."
msgstr "Consultez vos pauses terminées et les visites auxquelles vous avez renoncé."

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Langue du site"

#: apps/website/src/localization/index.ts
msgid "Works with"
msgstr "Fonctionne avec"

#: apps/website/src/localization/index.ts
msgid "You can read the code, suggest changes, or make it your own. There’s no advertising."
msgstr "Vous pouvez lire le code, proposer des changements ou l’adapter à vos besoins. Il n’y a pas de publicité."

#: apps/website/src/localization/index.ts
msgid "Your settings and stats stay in your browser. It even works offline and needs no account."
msgstr "Vos réglages et statistiques restent dans votre navigateur. L’extension fonctionne même hors ligne et ne nécessite aucun compte."

#: apps/website/src/localization/index.ts
msgid "Your videos will pause automatically"
msgstr "Vos vidéos se mettront en pause automatiquement"

#. Language-menu autonym. Keep this language name written in Russian.
#: apps/website/src/localization/index.ts
msgid "Русский"
msgstr "Русский"

