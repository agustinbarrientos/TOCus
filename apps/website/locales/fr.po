#: apps/website/src/localization/index.ts
msgid "A calmer moment before the next click."
msgstr "Un moment plus calme avant le prochain clic."

#: apps/website/src/localization/index.ts
msgid "Early development"
msgstr "Développement initial"

#: apps/website/src/localization/index.ts
msgid "Explore the source on GitHub"
msgstr "Explorer le code source sur GitHub"

#: apps/website/src/localization/index.ts
msgid "Open-source browser extension"
msgstr "Extension de navigateur open source"

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension in early development."
msgstr "TOCus est une extension de navigateur open source en cours de développement."

#: apps/website/src/localization/index.ts
msgid "TOCus is in early development, exploring a simple pause that supports more intentional browsing."
msgstr "TOCus est en cours de développement et explore une pause simple pour favoriser une navigation plus intentionnelle."

#: apps/website/src/localization/index.ts
msgid "TOCus v1 is local-only: no account, TOCus server, telemetry or product analytics, browsing-history analysis, or network requests for core operation."
msgstr "TOCus v1 fonctionne uniquement en local : aucun compte ou serveur TOCus, aucune télémétrie ou analyse du produit, aucune analyse de l’historique de navigation et aucune requête réseau pour son fonctionnement principal."

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Langue du site"
