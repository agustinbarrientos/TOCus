#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Confidentialité"

#: apps/website/src/localization/index.ts
msgid "Read the code, suggest changes, or make it your own."
msgstr "Lisez le code, proposez des modifications ou adaptez-le à vos besoins."

#: apps/website/src/localization/index.ts
msgid "Read the privacy policy"
msgstr "Lire la politique de confidentialité"

#: apps/website/src/localization/index.ts
msgid "See your progress."
msgstr "Suivez vos progrès."

#: apps/website/src/localization/index.ts
msgid "Select the sites where you want a pause."
msgstr "Sélectionnez les sites sur lesquels vous souhaitez une pause."

#: apps/website/src/localization/index.ts
msgid "Set the days and hours TOCus is active."
msgstr "Définissez les jours et les heures d’activation de TOCus."

#: apps/website/src/localization/index.ts
msgid "Set the pause to fit your day."
msgstr "Adaptez la pause à votre journée."

#: apps/website/src/localization/index.ts
msgid "Settings and statistics stay in your browser. TOCus works without an internet connection."
msgstr "Vos réglages et vos statistiques restent dans votre navigateur. TOCus fonctionne sans connexion internet."

#: apps/website/src/localization/index.ts
msgid "Six palettes with light, dark, or system appearance. Turn off breathing guidance or use reduced motion."
msgstr "Six palettes avec une apparence claire, sombre ou selon le système. Désactivez le guide de respiration ou réduisez les animations."

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Aller au contenu"

#: apps/website/src/localization/index.ts
msgid "Support"
msgstr "Assistance"

#: apps/website/src/localization/index.ts
msgid "Take a moment before you continue."
msgstr "Prenez un moment avant de continuer."

#: apps/website/src/localization/index.ts
msgid "Time left"
msgstr "Temps restant"

