#: apps/website/src/localization/index.ts
msgid "TOCus adds a gentle breathing pause before the websites you choose, helping you browse more intentionally."
msgstr "O TOCus adiciona uma breve pausa para respirar antes dos sites que você escolhe, ajudando a navegar com mais intenção."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "O TOCus é uma extensão de navegador de código aberto."

#: apps/website/src/localization/index.ts
msgid "TOCus works entirely on your device and will stay that way. No accounts, servers, tracking, browsing-history analysis, or external network requests."
msgstr "O TOCus funciona inteiramente no seu dispositivo e continuará assim. Sem contas, servidores, rastreamento, análise do histórico de navegação ou solicitações de rede externas."

