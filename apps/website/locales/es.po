#: apps/website/src/localization/index.ts
msgid "Privacy in your browser."
msgstr "Privacidad en tu navegador."

#: apps/website/src/localization/index.ts
msgid "10s pause"
msgstr "Pausa de 10 s"

#: apps/website/src/localization/index.ts
msgid "5m browsing"
msgstr "5 min de navegación"

#: apps/website/src/localization/index.ts
msgid "A preview of the breathing pause."
msgstr "Una vista previa de la pausa para respirar."

#: apps/website/src/localization/index.ts
msgid "A short pause before the websites you choose."
msgstr "Una breve pausa antes de los sitios web que elijas."

#: apps/website/src/localization/index.ts
msgid "A smiling capybara"
msgstr "Un capibara sonriente"

#: apps/website/src/localization/index.ts
msgid "Add a pause to your browser."
msgstr "Añade una pausa a tu navegador."

#: apps/website/src/localization/index.ts
msgid "Also available on"
msgstr "También disponible en"

#: apps/website/src/localization/index.ts
msgid "Appearance"
msgstr "Apariencia"

#: apps/website/src/localization/index.ts
msgid "Breathe"
msgstr "Respira"

#: apps/website/src/localization/index.ts
msgid "Breathe in"
msgstr "Inhala"

#: apps/website/src/localization/index.ts
msgid "Browse"
msgstr "Navega"

#: apps/website/src/localization/index.ts
msgid "Browse until the next pause."
msgstr "Navega hasta la próxima pausa."

#: apps/website/src/localization/index.ts
msgid "By default, the next pause comes five minutes after you select Continue."
msgstr "De forma predeterminada, la siguiente pausa llega cinco minutos después de seleccionar Continuar."

#: apps/website/src/localization/index.ts
msgid "Choose different active days and hours for each website. Pause timing applies to all your selected sites."
msgstr "Elige días y horas de actividad distintos para cada sitio. Los tiempos de pausa se aplican a todos los sitios que selecciones."

#: apps/website/src/localization/index.ts
msgid "Choose sites"
msgstr "Elige sitios"

#: apps/website/src/localization/index.ts
msgid "Choose your sites."
msgstr "Elige tus sitios."

#: apps/website/src/localization/index.ts
msgid "Choose your wait, browsing time, and schedule."
msgstr "Elige la espera, el tiempo de navegación y el horario."

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "Próximamente"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "Continuar"

#: apps/website/src/localization/index.ts
msgid "Continue after the pause"
msgstr "Continúa después de la pausa"

#: apps/website/src/localization/index.ts
msgid "Custom schedules for each site"
msgstr "Horarios personalizados para cada sitio"

#. Language-menu autonym. Keep this language name written in German.
#: apps/website/src/localization/index.ts
msgid "Deutsch"
msgstr "Deutsch"

#: apps/website/src/localization/index.ts
msgid "Download for"
msgstr "Descargar para"

#: apps/website/src/localization/index.ts
msgid "Download TOCus"
msgstr "Descarga TOCus"

#. Language-menu autonym. Keep this language name written in English.
#: apps/website/src/localization/index.ts
msgid "English"
msgstr "English"

#. Language-menu autonym for the tuteo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (tú)"
msgstr "Español (tú)"

#. Language-menu autonym for the voseo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (vos)"
msgstr "Español (vos)"

#: apps/website/src/localization/index.ts
msgid "Example data"
msgstr "Datos de ejemplo"

#: apps/website/src/localization/index.ts
msgid "Example timing"
msgstr "Ejemplo de tiempos"

#: apps/website/src/localization/index.ts
msgid "Explore the source on GitHub"
msgstr "Explora el código fuente en GitHub"

#: apps/website/src/localization/index.ts
msgid "Follow the breathing guide. Your browsing time has not started yet."
msgstr "Sigue la guía de respiración. Tu tiempo de navegación aún no ha comenzado."

#. Language-menu autonym. Keep this language name written in French.
#: apps/website/src/localization/index.ts
msgid "Français"
msgstr "Français"

#: apps/website/src/localization/index.ts
msgid "Free and open source"
msgstr "Gratis y de código abierto"

#: apps/website/src/localization/index.ts
msgid "Free and open source."
msgstr "Gratis y de código abierto."

#: apps/website/src/localization/index.ts
msgid "How it works"
msgstr "Cómo funciona"

#: apps/website/src/localization/index.ts
msgid "How TOCus works."
msgstr "Cómo funciona TOCus."

#. Language-menu autonym. Keep this language name written in Italian.
#: apps/website/src/localization/index.ts
msgid "Italiano"
msgstr "Italiano"

#: apps/website/src/localization/index.ts
msgid "Made by"
msgstr "Hecho por"

#: apps/website/src/localization/index.ts
msgid "Meet the creator"
msgstr "Conoce al creador"

#: apps/website/src/localization/index.ts
msgid "No account is needed to use the extension."
msgstr "No necesitas una cuenta para usar la extensión."

#: apps/website/src/localization/index.ts
msgid "You can use TOCus without an account."
msgstr "Puedes usar TOCus sin una cuenta."

#: apps/website/src/localization/index.ts
msgid "The extension does not contact external services."
msgstr "La extensión no se conecta a servicios externos."

#: apps/website/src/localization/index.ts
msgid "The extension has no analytics or advertising."
msgstr "La extensión no incluye analítica ni publicidad."

#: apps/website/src/localization/index.ts
msgid "TOCus pauses playing videos on supported sites during the wait and resumes them when you continue."
msgstr "TOCus pausa los vídeos en reproducción durante la espera en los sitios compatibles y los reanuda cuando continúas."

#: apps/website/src/localization/index.ts
msgid "Only when you want"
msgstr "Solo cuando quieras"

#: apps/website/src/localization/index.ts
msgid "Open a site"
msgstr "Abre un sitio"

#: apps/website/src/localization/index.ts
msgid "Open a website you added to TOCus."
msgstr "Abre un sitio web que hayas añadido a TOCus."

#: apps/website/src/localization/index.ts
msgid "Open-source browser extension"
msgstr "Extensión de navegador de código abierto"

#: apps/website/src/localization/index.ts
msgid "Pause and browsing time"
msgstr "Tiempo de pausa y navegación"

#: apps/website/src/localization/index.ts
msgid "Pause before you scroll."
msgstr "Haz una pausa antes de hacer scroll."

#: apps/website/src/localization/index.ts
msgid "See counts of completed pauses and reconsidered visits."
msgstr "Consulta cuántas pausas has completado y cuántas visitas has reconsiderado."

#. Language-menu autonym for Brazilian Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Brasil)"
msgstr "Português (Brasil)"

#. Language-menu autonym for European Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Portugal)"
msgstr "Português (Portugal)"

#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Privacidad"

#: apps/website/src/localization/index.ts
msgid "Read the code, suggest changes, or make it your own."
msgstr "Lee el código, propón cambios o adáptalo a tu gusto."

#: apps/website/src/localization/index.ts
msgid "Read the privacy policy"
msgstr "Lee la política de privacidad"

#: apps/website/src/localization/index.ts
msgid "Your pauses, over time."
msgstr "Tus pausas a lo largo del tiempo."

#: apps/website/src/localization/index.ts
msgid "TOCus pauses before opening the websites you add."
msgstr "TOCus hace una pausa antes de abrir los sitios que añadas."

#: apps/website/src/localization/index.ts
msgid "Set the days and hours TOCus is active."
msgstr "Define los días y las horas en que TOCus está activo."

#: apps/website/src/localization/index.ts
msgid "Set the pause to fit your day."
msgstr "Adapta la pausa a tu día."

#: apps/website/src/localization/index.ts
msgid "Your settings and statistics stay in your browser. The extension works offline."
msgstr "Tu configuración y tus estadísticas se guardan en tu navegador. La extensión funciona sin conexión."

#: apps/website/src/localization/index.ts
msgid "Six palettes with light, dark, or system appearance. Motion follows your operating system's reduced motion setting."
msgstr "Seis paletas con apariencia clara, oscura o del sistema. Las animaciones siguen el ajuste de movimiento reducido de tu sistema operativo."

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Saltar al contenido"

#: apps/website/src/localization/index.ts
msgid "Support"
msgstr "Ayuda"

#: apps/website/src/localization/index.ts
msgid "Take a moment before you continue."
msgstr "Tómate un momento antes de continuar."

#: apps/website/src/localization/index.ts
msgid "Time left"
msgstr "Tiempo restante"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "TOCus añade una pausa para respirar a los sitios web que eliges."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus es una extensión de navegador de código abierto."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Ver el código fuente"

#: apps/website/src/localization/index.ts
msgid "Visit a website"
msgstr "Visita un sitio web"

#: apps/website/src/localization/index.ts
msgid "Website added"
msgstr "Sitio web añadido"

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Idioma del sitio web"

#: apps/website/src/localization/index.ts
msgid "When the wait ends, select Continue to open the website, or close the tab."
msgstr "Cuando termine la espera, selecciona Continuar para abrir el sitio web o cierra la pestaña."

#: apps/website/src/localization/index.ts
msgid "Stored on your device."
msgstr "Datos guardados en tu dispositivo."

#: apps/website/src/localization/index.ts
msgid "Your video pauses, too."
msgstr "Tu vídeo también se pausa."

