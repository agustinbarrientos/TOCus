#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Privacidad"

#: apps/website/src/localization/index.ts
msgid "Privacy policy"
msgstr "Política de privacidad"

#: apps/website/src/localization/index.ts
msgid "Read the code, suggest changes, or make it your own. No advertising."
msgstr "Lee el código, sugiere cambios o adáptalo a tu gusto. Sin publicidad."

#: apps/website/src/localization/index.ts
msgid "See completed pauses and reconsidered visits."
msgstr "Consulta las pausas completadas y las visitas reconsideradas."

#: apps/website/src/localization/index.ts
msgid "See how much time you saved"
msgstr "Mira cuánto tiempo has ahorrado"

#: apps/website/src/localization/index.ts
msgid "Set the days and hours TOCus is active."
msgstr "Define los días y las horas en que TOCus está activo."

#: apps/website/src/localization/index.ts
msgid "Settings and statistics stay in your browser. Works offline, without an account."
msgstr "Los ajustes y las estadísticas se guardan en tu navegador. Funciona sin conexión y sin cuenta."

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Saltar al contenido"

#: apps/website/src/localization/index.ts
msgid "Source"
msgstr "Código fuente"

#: apps/website/src/localization/index.ts
msgid "Stored on your device"
msgstr "Datos guardados en tu dispositivo"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "TOCus añade una pausa para respirar a los sitios web que eliges."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus es una extensión de navegador de código abierto."

#: apps/website/src/localization/index.ts
msgid "Take a little pause."
msgstr "Haz una pequeña pausa."

#: apps/website/src/localization/index.ts
msgid "Videos pause during the wait and resume when you continue."
msgstr "Los vídeos se pausan durante la espera y se reanudan cuando continúas."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Ver el código fuente"

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Idioma del sitio web"

#: apps/website/src/localization/index.ts
msgid "YouTube, Netflix, Twitch and more"
msgstr "YouTube, Netflix, Twitch y más"

#: apps/website/src/localization/index.ts
msgid "Your video pauses, too"
msgstr "Tu vídeo también se pausa"

