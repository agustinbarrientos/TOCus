#: apps/website/src/localization/index.ts
msgid "Choose different active days and hours for each website."
msgstr "Elige días y horas de actividad distintos para cada sitio."

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "Próximamente"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "Continuar"

#: apps/website/src/localization/index.ts
msgid "Custom schedules for each site"
msgstr "Horarios personalizados para cada sitio"

