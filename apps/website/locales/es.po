#: apps/website/src/localization/index.ts
msgid "10s pause"
msgstr "Pausa de 10 s"

#: apps/website/src/localization/index.ts
msgid "5m browsing"
msgstr "5 min de navegación"

#: apps/website/src/localization/index.ts
msgid "A calmer way to browse"
msgstr "Una forma más tranquila de navegar"

#: apps/website/src/localization/index.ts
msgid "Also available on"
msgstr "También disponible en"

#: apps/website/src/localization/index.ts
msgid "Check how much time you’ve saved"
msgstr "Comprueba cuánto tiempo has ahorrado"

#: apps/website/src/localization/index.ts
msgid "Choose the days and hours TOCus is active."
msgstr "Elige los días y las horas en que TOCus está activo."

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "Próximamente"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "Continuar"

#. Language-menu autonym. Keep this language name written in German.
#: apps/website/src/localization/index.ts
msgid "Deutsch"
msgstr "Deutsch"

#: apps/website/src/localization/index.ts
msgid "Download for"
msgstr "Descargar para"

#. Language-menu autonym. Keep this language name written in English.
#: apps/website/src/localization/index.ts
msgid "English"
msgstr "English"

#. Language-menu autonym for the tuteo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (tú)"
msgstr "Español (tú)"

#. Language-menu autonym for the voseo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (vos)"
msgstr "Español (vos)"

#: apps/website/src/localization/index.ts
msgid "Everything is stored on your device"
msgstr "Todo se guarda en tu dispositivo"

#. Language-menu autonym. Keep this language name written in French.
#: apps/website/src/localization/index.ts
msgid "Français"
msgstr "Français"

#. Language-menu autonym. Keep this language name written in Italian.
#: apps/website/src/localization/index.ts
msgid "Italiano"
msgstr "Italiano"

#: apps/website/src/localization/index.ts
msgid "It’s free and open source"
msgstr "Es gratis y de código abierto"

#: apps/website/src/localization/index.ts
msgid "Made by"
msgstr "Hecho por"

#: apps/website/src/localization/index.ts
msgid "Open a site"
msgstr "Abre un sitio"

#: apps/website/src/localization/index.ts
msgid "Pause before visiting addictive websites"
msgstr "Haz una pausa antes de visitar sitios web adictivos"

#: apps/website/src/localization/index.ts
msgid "Pick different days and times for each site."
msgstr "Elige días y horarios distintos para cada sitio."

#. Language-menu autonym for Brazilian Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Brasil)"
msgstr "Português (Brasil)"

#. Language-menu autonym for European Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Portugal)"
msgstr "Português (Portugal)"

#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Privacidad"

#: apps/website/src/localization/index.ts
msgid "Privacy policy"
msgstr "Política de privacidad"

#: apps/website/src/localization/index.ts
msgid "Set a custom schedule for each site"
msgstr "Configura un horario para cada sitio"

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Saltar al contenido"

#: apps/website/src/localization/index.ts
msgid "Source code"
msgstr "Código fuente"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "TOCus añade una pausa para respirar a los sitios web que eliges."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus es una extensión de navegador de código abierto."

#: apps/website/src/localization/index.ts
msgid "Take a moment to pause."
msgstr "Tómate un momento para hacer una pausa."

#: apps/website/src/localization/index.ts
msgid "Use it only when you want to"
msgstr "Úsalo solo cuando quieras"

#: apps/website/src/localization/index.ts
msgid "Videos pause while you wait and resume when you’re ready."
msgstr "Los vídeos se pausan mientras esperas y se reanudan cuando quieras continuar."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Ver el código fuente"

#: apps/website/src/localization/index.ts
msgid "View your completed pauses and visits you changed your mind about."
msgstr "Consulta tus pausas completadas y las visitas que decidiste no hacer."

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Idioma del sitio web"

#: apps/website/src/localization/index.ts
msgid "Works with"
msgstr "Funciona con"

#: apps/website/src/localization/index.ts
msgid "You can read the code, suggest changes, or make it your own. There’s no advertising."
msgstr "Puedes leer el código, sugerir cambios o adaptarlo a tu gusto. No hay publicidad."

#: apps/website/src/localization/index.ts
msgid "Your settings and stats stay in your browser. It even works offline and needs no account."
msgstr "Tus ajustes y estadísticas se guardan en tu navegador. Incluso funciona sin conexión y no necesita una cuenta."

#: apps/website/src/localization/index.ts
msgid "Your videos will pause automatically"
msgstr "Tus vídeos se pausarán automáticamente"

#. Language-menu autonym. Keep this language name written in Russian.
#: apps/website/src/localization/index.ts
msgid "Русский"
msgstr "Русский"

