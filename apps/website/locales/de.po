msgstr "Datenschutz"

#: apps/website/src/localization/index.ts
msgid "Private and safe"
msgstr "Privat und sicher"

#: apps/website/src/localization/index.ts
msgid "Read the code, suggest changes, or make it your own."
msgstr "Lies den Code, schlage Änderungen vor oder passe ihn an."

#: apps/website/src/localization/index.ts
msgid "Read the privacy policy"
msgstr "Datenschutzerklärung lesen"

#: apps/website/src/localization/index.ts
msgid "Ready when you are"
msgstr "Mach weiter, wenn du bereit bist"

#: apps/website/src/localization/index.ts
msgid "Reconsidered visits"
