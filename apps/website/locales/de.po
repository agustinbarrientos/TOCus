#: apps/website/src/localization/index.ts
msgid "Choose different active days and hours for each website."
msgstr "Wähle für jede Website eigene aktive Tage und Uhrzeiten."

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "Demnächst"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "Fortfahren"

#: apps/website/src/localization/index.ts
msgid "Custom schedules for each site"
msgstr "Eigene Zeitpläne für jede Website"

