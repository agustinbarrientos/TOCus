#: apps/website/src/localization/index.ts
msgid "Português (Portugal)"
msgstr "Português (Portugal)"

#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Datenschutz"

#: apps/website/src/localization/index.ts
msgid "Privacy policy"
msgstr "Datenschutzerklärung"

#: apps/website/src/localization/index.ts
msgid "Read the code, suggest changes, or make it your own. No advertising."
msgstr "Lies den Code, schlage Änderungen vor oder passe ihn an. Ohne Werbung."

#: apps/website/src/localization/index.ts
msgid "See completed pauses and reconsidered visits."
msgstr "Sieh dir abgeschlossene Pausen und überdachte Besuche an."

#: apps/website/src/localization/index.ts
msgid "See how much time you saved"
msgstr "Sieh, wie viel Zeit du gespart hast"

#: apps/website/src/localization/index.ts
msgid "Set the days and hours TOCus is active."
msgstr "Lege die Tage und Uhrzeiten fest, an denen TOCus aktiv ist."

#: apps/website/src/localization/index.ts
msgid "Settings and statistics stay in your browser. Works offline, without an account."
msgstr "Einstellungen und Statistiken bleiben in deinem Browser. Funktioniert offline, ohne Konto."

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Zum Inhalt springen"

#: apps/website/src/localization/index.ts
msgid "Source"
msgstr "Quellcode"

#: apps/website/src/localization/index.ts
msgid "Stored on your device"
msgstr "Auf deinem Gerät gespeichert"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "TOCus fügt den von dir gewählten Websites eine Atempause hinzu."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus ist eine Open-Source-Browsererweiterung."

#: apps/website/src/localization/index.ts
msgid "Take a little pause."
msgstr "Mach eine kleine Pause."

#: apps/website/src/localization/index.ts
msgid "Videos pause during the wait and resume when you continue."
msgstr "Videos pausieren während der Wartezeit und laufen weiter, wenn du fortfährst."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Quellcode ansehen"

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Sprache der Website"

#: apps/website/src/localization/index.ts
msgid "YouTube, Netflix, Twitch and more"
msgstr "YouTube, Netflix, Twitch und mehr"

#: apps/website/src/localization/index.ts
msgid "Your video pauses, too"
msgstr "Auch dein Video pausiert"

