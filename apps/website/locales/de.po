msgid "Take a moment before you continue"
msgstr "Nimm dir einen Moment, bevor du fortfährst"

#: apps/website/src/localization/index.ts
msgid "The extension does not contact external services."
msgstr "Die Erweiterung kontaktiert keine externen Dienste."

#: apps/website/src/localization/index.ts
msgid "The extension has no advertising."
msgstr "Die Erweiterung enthält keine Werbung."

#: apps/website/src/localization/index.ts
msgid "The extension has no analytics."
msgstr "Die Erweiterung erfasst keine Nutzungsanalysen."

#: apps/website/src/localization/index.ts
msgid "Time left"
msgstr "Verbleibende Zeit"

#: apps/website/src/localization/index.ts
msgid "Time spent pausing plus estimated browsing time avoided, based on your configured visit time."
msgstr "Zeit für Pausen plus geschätzte vermiedene Surfzeit, basierend auf deiner eingestellten Besuchsdauer."

#: apps/website/src/localization/index.ts
msgid "Time you took to pause"
msgstr "Zeit für deine Pausen"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "TOCus fügt den von dir gewählten Websites eine Atempause hinzu."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus ist eine Open-Source-Browsererweiterung."

#: apps/website/src/localization/index.ts
msgid "TOCus pauses before opening the websites you add."
msgstr "TOCus legt eine Pause ein, bevor die von dir hinzugefügten Websites geöffnet werden."

#: apps/website/src/localization/index.ts
msgid "TOCus pauses playing videos on supported sites during the wait and resumes them when you continue."
msgstr "TOCus hält laufende Videos auf unterstützten Websites während der Wartezeit an und setzt sie fort, wenn du weitermachst."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Quellcode ansehen"

#: apps/website/src/localization/index.ts
msgid "Visit a website"
msgstr "Besuche eine Website"

#: apps/website/src/localization/index.ts
msgid "Website added"
msgstr "Website hinzugefügt"

#: apps/website/src/localization/index.ts
msgid "Website address"
msgstr "Website-Adresse"

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Sprache der Website"

#: apps/website/src/localization/index.ts
msgid "When the wait ends, select Continue to open the website, or close the tab."
msgstr "Wähle nach der Wartezeit Fortfahren, um die Website zu öffnen, oder schließe den Tab."

#: apps/website/src/localization/index.ts
msgid "You can use TOCus without an account."
msgstr "Du kannst TOCus ohne Konto nutzen."

#: apps/website/src/localization/index.ts
msgid "Your settings and statistics stay in your browser. The extension works offline."
msgstr "Deine Einstellungen und Statistiken bleiben in deinem Browser. Die Erweiterung funktioniert offline."

#: apps/website/src/localization/index.ts
msgid "Your video pauses, too"
msgstr "Auch dein Video pausiert"

