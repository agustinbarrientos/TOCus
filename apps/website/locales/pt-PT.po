#. Language-menu autonym. Keep this language name written in French.
#: apps/website/src/localization/index.ts
msgid "Français"
msgstr "Français"

#: apps/website/src/localization/index.ts
msgid "Free and open source"
msgstr "Gratuito e de código aberto"

#: apps/website/src/localization/index.ts
msgid "How it works"
msgstr "Como funciona"

#. Language-menu autonym. Keep this language name written in Italian.
#: apps/website/src/localization/index.ts
msgid "Italiano"
msgstr "Italiano"

#: apps/website/src/localization/index.ts
msgid "Made by"
msgstr "Criado por"

#: apps/website/src/localization/index.ts
msgid "Only when you want"
msgstr "Só quando quiseres"

#: apps/website/src/localization/index.ts
msgid "Open a site"
msgstr "Abre um site"

#: apps/website/src/localization/index.ts
msgid "Pause before visiting addictive websites"
