#: apps/website/src/localization/index.ts
msgid "A calmer moment before the next click."
msgstr "Um momento mais tranquilo antes do próximo clique."

#: apps/website/src/localization/index.ts
msgid "Early development"
msgstr "Desenvolvimento inicial"

#: apps/website/src/localization/index.ts
msgid "Explore the source on GitHub"
msgstr "Explore o código-fonte no GitHub"

#: apps/website/src/localization/index.ts
msgid "Open-source browser extension"
msgstr "Extensão de navegador de código aberto"

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension in early development."
msgstr "O TOCus é uma extensão de navegador de código aberto em desenvolvimento inicial."

#: apps/website/src/localization/index.ts
msgid "TOCus is in early development, exploring a simple pause that supports more intentional browsing."
msgstr "O TOCus está em desenvolvimento inicial e explora uma pausa simples que ajuda a navegar com mais intenção."

#: apps/website/src/localization/index.ts
msgid "TOCus v1 is local-only: no account, TOCus server, telemetry or product analytics, browsing-history analysis, or network requests for core operation."
msgstr "O TOCus v1 funciona apenas de forma local: sem conta, servidor do TOCus, telemetria ou análise de produto, análise do histórico de navegação ou pedidos de rede para o funcionamento principal."

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Idioma do site"
