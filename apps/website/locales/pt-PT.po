#: apps/website/src/localization/index.ts
msgid "Time you took to pause"
msgstr "Tempo dedicado à pausa"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "O TOCus adiciona uma pausa para respirar aos sites que escolheres."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "O TOCus é uma extensão de navegador de código aberto."

#: apps/website/src/localization/index.ts
msgid "TOCus pauses before opening the websites you add."
msgstr "O TOCus faz uma pausa antes de abrir os sites que adicionares."

#: apps/website/src/localization/index.ts
msgid "TOCus pauses playing videos on supported sites during the wait and resumes them when you continue."
msgstr "O TOCus pausa os vídeos em reprodução durante a espera nos sites compatíveis e retoma a reprodução quando continuas."

#: apps/website/src/localization/index.ts
