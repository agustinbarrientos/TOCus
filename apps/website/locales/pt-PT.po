#: apps/website/src/localization/index.ts
msgid "10s pause"
msgstr "Pausa de 10 s"

#: apps/website/src/localization/index.ts
msgid "5m browsing"
msgstr "5 min de navegação"

#: apps/website/src/localization/index.ts
msgid "A calmer way to browse"
msgstr "Uma forma mais tranquila de navegar"

#: apps/website/src/localization/index.ts
msgid "Also available on"
msgstr "Também disponível para"

#: apps/website/src/localization/index.ts
msgid "Choose different active days and hours for each website."
msgstr "Escolhe dias e horas de atividade diferentes para cada site."

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "Em breve"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "Continua"

#: apps/website/src/localization/index.ts
msgid "Custom schedules for each site"
msgstr "Horários personalizados para cada site"

