#. Language-menu autonym for European Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Portugal)"
msgstr "Português (Portugal)"

#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Privacidade"

#: apps/website/src/localization/index.ts
msgid "Privacy policy"
msgstr "Política de privacidade"

#: apps/website/src/localization/index.ts
msgid "Read the code, suggest changes, or make it your own. No advertising."
msgstr "Lê o código, sugere alterações ou adapta-o ao teu gosto. Sem publicidade."

#: apps/website/src/localization/index.ts
msgid "See completed pauses and reconsidered visits."
msgstr "Vê as pausas concluídas e as visitas reconsideradas."

#: apps/website/src/localization/index.ts
msgid "See how much time you saved"
msgstr "Vê quanto tempo poupaste"

#: apps/website/src/localization/index.ts
msgid "Set the days and hours TOCus is active."
msgstr "Define os dias e as horas em que o TOCus está ativo."

#: apps/website/src/localization/index.ts
msgid "Settings and statistics stay in your browser. Works offline, without an account."
msgstr "As definições e estatísticas ficam no teu navegador. Funciona offline, sem conta."

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Saltar para o conteúdo"

#: apps/website/src/localization/index.ts
msgid "Source"
msgstr "Código-fonte"

#: apps/website/src/localization/index.ts
msgid "Stored on your device"
msgstr "Dados guardados no teu dispositivo"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "O TOCus adiciona uma pausa para respirar aos sites que escolheres."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "O TOCus é uma extensão de navegador de código aberto."

#: apps/website/src/localization/index.ts
msgid "Take a little pause."
msgstr "Faz uma pequena pausa."

#: apps/website/src/localization/index.ts
msgid "Videos pause during the wait and resume when you continue."
msgstr "Os vídeos pausam durante a espera e retomam quando continuas."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Ver o código-fonte"

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Idioma do site"

#: apps/website/src/localization/index.ts
msgid "YouTube, Netflix, Twitch and more"
msgstr "YouTube, Netflix, Twitch e mais"

#: apps/website/src/localization/index.ts
msgid "Your video pauses, too"
msgstr "O teu vídeo também pausa"

