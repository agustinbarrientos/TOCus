#: apps/website/src/localization/index.ts
msgid "A calmer moment before the next click."
msgstr "Un momento más tranquilo antes del próximo clic."

#: apps/website/src/localization/index.ts
msgid "Early development"
msgstr "Desarrollo inicial"

#: apps/website/src/localization/index.ts
msgid "Explore the source on GitHub"
msgstr "Explorá el código fuente en GitHub"

#: apps/website/src/localization/index.ts
msgid "Open-source browser extension"
msgstr "Extensión de navegador de código abierto"

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension in early development."
msgstr "TOCus es una extensión de navegador de código abierto en desarrollo inicial."

#: apps/website/src/localization/index.ts
msgid "TOCus is in early development, exploring a simple pause that supports more intentional browsing."
msgstr "TOCus está en desarrollo inicial y explora una pausa sencilla que te ayuda a navegar con más intención."

#: apps/website/src/localization/index.ts
msgid "TOCus v1 is local-only: no account, TOCus server, telemetry or product analytics, browsing-history analysis, or network requests for core operation."
msgstr "TOCus v1 funciona solo de forma local: no necesita una cuenta ni servidores de TOCus, y no usa telemetría, analítica de producto, análisis del historial de navegación ni solicitudes de red para su funcionamiento principal."

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Idioma del sitio web"
