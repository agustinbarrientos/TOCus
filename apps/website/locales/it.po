#: apps/website/src/localization/index.ts
msgid "Privacy in your browser."
msgstr "Privacy nel tuo browser."

#: apps/website/src/localization/index.ts
msgid "10s pause"
msgstr "Pausa di 10 s"

#: apps/website/src/localization/index.ts
msgid "5m browsing"
msgstr "5 min di navigazione"

#: apps/website/src/localization/index.ts
msgid "A preview of the breathing pause."
msgstr "Un’anteprima della pausa per respirare."

#: apps/website/src/localization/index.ts
msgid "A short pause before the websites you choose."
msgstr "Una breve pausa prima dei siti che scegli."

#: apps/website/src/localization/index.ts
msgid "A smiling capybara"
msgstr "Un capibara sorridente"

#: apps/website/src/localization/index.ts
msgid "Add a pause to your browser."
msgstr "Aggiungi una pausa al tuo browser."

#: apps/website/src/localization/index.ts
msgid "Also available on"
msgstr "Disponibile anche per"

#: apps/website/src/localization/index.ts
msgid "Appearance"
msgstr "Aspetto"

#: apps/website/src/localization/index.ts
msgid "Breathe"
msgstr "Respira"

#: apps/website/src/localization/index.ts
msgid "Breathe in"
msgstr "Inspira"

#: apps/website/src/localization/index.ts
msgid "Browse"
msgstr "Naviga"

#: apps/website/src/localization/index.ts
msgid "Browse until the next pause."
msgstr "Naviga fino alla prossima pausa."

#: apps/website/src/localization/index.ts
msgid "By default, the next pause comes five minutes after you select Continue."
msgstr "Per impostazione predefinita, la pausa successiva arriva cinque minuti dopo aver selezionato Continua."

#: apps/website/src/localization/index.ts
msgid "Choose different active days and hours for each website. Pause timing applies to all your selected sites."
msgstr "Scegli giorni e orari di attività diversi per ogni sito. I tempi di pausa si applicano a tutti i siti selezionati."

#: apps/website/src/localization/index.ts
msgid "Choose sites"
msgstr "Scegli i siti"

#: apps/website/src/localization/index.ts
msgid "Choose your sites."
msgstr "Scegli i tuoi siti."

#: apps/website/src/localization/index.ts
msgid "Choose your wait, browsing time, and schedule."
msgstr "Scegli l’attesa, il tempo di navigazione e gli orari."

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "Prossimamente"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "Continua"

#: apps/website/src/localization/index.ts
msgid "Continue after the pause"
msgstr "Continua dopo la pausa"

#: apps/website/src/localization/index.ts
msgid "Custom schedules for each site"
msgstr "Orari personalizzati per ogni sito"

#. Language-menu autonym. Keep this language name written in German.
#: apps/website/src/localization/index.ts
msgid "Deutsch"
msgstr "Deutsch"

#: apps/website/src/localization/index.ts
msgid "Download for"
msgstr "Scarica per"

#: apps/website/src/localization/index.ts
msgid "Download TOCus"
msgstr "Scarica TOCus"

#. Language-menu autonym. Keep this language name written in English.
#: apps/website/src/localization/index.ts
msgid "English"
msgstr "English"

#. Language-menu autonym for the tuteo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (tú)"
msgstr "Español (tú)"

#. Language-menu autonym for the voseo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (vos)"
msgstr "Español (vos)"

#: apps/website/src/localization/index.ts
msgid "Example data"
msgstr "Dati di esempio"

#: apps/website/src/localization/index.ts
msgid "Example timing"
msgstr "Esempio di tempistiche"

#: apps/website/src/localization/index.ts
msgid "Explore the source on GitHub"
msgstr "Esplora il codice sorgente su GitHub"

#: apps/website/src/localization/index.ts
msgid "Follow the breathing guide. Your browsing time has not started yet."
msgstr "Segui la guida alla respirazione. Il tempo di navigazione non è ancora iniziato."

#. Language-menu autonym. Keep this language name written in French.
#: apps/website/src/localization/index.ts
msgid "Français"
msgstr "Français"

#: apps/website/src/localization/index.ts
msgid "Free and open source"
msgstr "Gratuito e open source"

#: apps/website/src/localization/index.ts
msgid "Free and open source."
msgstr "Gratis e open source."

#: apps/website/src/localization/index.ts
msgid "How it works"
msgstr "Come funziona"

#: apps/website/src/localization/index.ts
msgid "How TOCus works."
msgstr "Come funziona TOCus."

#. Language-menu autonym. Keep this language name written in Italian.
#: apps/website/src/localization/index.ts
msgid "Italiano"
msgstr "Italiano"

#: apps/website/src/localization/index.ts
msgid "Made by"
msgstr "Creato da"

#: apps/website/src/localization/index.ts
msgid "Meet the creator"
msgstr "Conosci il creatore"

#: apps/website/src/localization/index.ts
msgid "No account is needed to use the extension."
msgstr "Non serve un account per usare l'estensione."

#: apps/website/src/localization/index.ts
msgid "You can use TOCus without an account."
msgstr "Puoi usare TOCus senza un account."

#: apps/website/src/localization/index.ts
msgid "The extension does not contact external services."
msgstr "L'estensione non contatta servizi esterni."

#: apps/website/src/localization/index.ts
msgid "The extension has no analytics or advertising."
msgstr "L'estensione non include analisi dell'utilizzo o pubblicità."

#: apps/website/src/localization/index.ts
msgid "TOCus pauses playing videos on supported sites during the wait and resumes them when you continue."
msgstr "TOCus mette in pausa i video in riproduzione durante l'attesa sui siti supportati e li riprende quando continui."

#: apps/website/src/localization/index.ts
msgid "Only when you want"
msgstr "Solo quando vuoi"

#: apps/website/src/localization/index.ts
msgid "Open a site"
msgstr "Apri un sito"

#: apps/website/src/localization/index.ts
msgid "Open a website you added to TOCus."
msgstr "Apri un sito web che hai aggiunto a TOCus."

#: apps/website/src/localization/index.ts
msgid "Open-source browser extension"
msgstr "Estensione open source per browser"

#: apps/website/src/localization/index.ts
msgid "Pause and browsing time"
msgstr "Tempo di pausa e navigazione"

#: apps/website/src/localization/index.ts
msgid "Pause before you scroll."
msgstr "Fermati prima di scorrere."

#: apps/website/src/localization/index.ts
msgid "See counts of completed pauses and reconsidered visits."
msgstr "Controlla quante pause hai completato e quante visite hai riconsiderato."

#. Language-menu autonym for Brazilian Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Brasil)"
msgstr "Português (Brasil)"

#. Language-menu autonym for European Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Portugal)"
msgstr "Português (Portugal)"

#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Privacy"

#: apps/website/src/localization/index.ts
msgid "Read the code, suggest changes, or make it your own."
msgstr "Leggi il codice, suggerisci modifiche o adattalo alle tue esigenze."

#: apps/website/src/localization/index.ts
msgid "Read the privacy policy"
msgstr "Leggi l’informativa sulla privacy"

#: apps/website/src/localization/index.ts
msgid "Your pauses, over time."
msgstr "Le tue pause nel tempo."

#: apps/website/src/localization/index.ts
msgid "TOCus pauses before opening the websites you add."
msgstr "TOCus fa una pausa prima di aprire i siti che aggiungi."

#: apps/website/src/localization/index.ts
msgid "Set the days and hours TOCus is active."
msgstr "Imposta i giorni e le ore in cui TOCus è attivo."

#: apps/website/src/localization/index.ts
msgid "Set the pause to fit your day."
msgstr "Adatta la pausa alla tua giornata."

#: apps/website/src/localization/index.ts
msgid "Your settings and statistics stay in your browser. The extension works offline."
msgstr "Le tue impostazioni e statistiche restano nel tuo browser. L'estensione funziona offline."

#: apps/website/src/localization/index.ts
msgid "Six palettes with light, dark, or system appearance. Motion follows your operating system's reduced motion setting."
msgstr "Sei palette con aspetto chiaro, scuro o di sistema. Le animazioni seguono l'impostazione di riduzione del movimento del sistema operativo."

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Vai al contenuto"

#: apps/website/src/localization/index.ts
msgid "Support"
msgstr "Assistenza"

#: apps/website/src/localization/index.ts
msgid "Take a moment before you continue."
msgstr "Prenditi un momento prima di continuare."

#: apps/website/src/localization/index.ts
msgid "Time left"
msgstr "Tempo rimasto"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "TOCus aggiunge una pausa per respirare ai siti web che scegli."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus è un’estensione del browser open source."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Visualizza il codice sorgente"

#: apps/website/src/localization/index.ts
msgid "Visit a website"
msgstr "Visita un sito web"

#: apps/website/src/localization/index.ts
msgid "Website added"
msgstr "Sito web aggiunto"

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Lingua del sito"

#: apps/website/src/localization/index.ts
msgid "When the wait ends, select Continue to open the website, or close the tab."
msgstr "Quando termina l’attesa, seleziona Continua per aprire il sito web oppure chiudi la scheda."

#: apps/website/src/localization/index.ts
msgid "Stored on your device."
msgstr "Dati salvati sul tuo dispositivo."

#: apps/website/src/localization/index.ts
msgid "Your video pauses, too."
msgstr "Anche il tuo video va in pausa."

#. Language-menu autonym. Keep this language name written in Russian.
#: apps/website/src/localization/index.ts
msgid "Русский"
msgstr "Русский"

