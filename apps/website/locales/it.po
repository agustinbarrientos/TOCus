#: apps/website/src/localization/index.ts
msgid "10s pause"
msgstr "Pausa di 10 s"

#: apps/website/src/localization/index.ts
msgid "5m browsing"
msgstr "5 min di navigazione"

#: apps/website/src/localization/index.ts
msgid "A calmer way to browse"
msgstr "Un modo più tranquillo di navigare"

#: apps/website/src/localization/index.ts
msgid "Also available on"
msgstr "Disponibile anche per"

#: apps/website/src/localization/index.ts
msgid "Check how much time you’ve saved"
msgstr "Scopri quanto tempo hai risparmiato"

#: apps/website/src/localization/index.ts
msgid "Choose the days and hours TOCus is active."
msgstr "Scegli i giorni e gli orari in cui TOCus è attivo."

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "Prossimamente"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "Continua"

#. Language-menu autonym. Keep this language name written in German.
#: apps/website/src/localization/index.ts
msgid "Deutsch"
msgstr "Deutsch"

#: apps/website/src/localization/index.ts
msgid "Download for"
msgstr "Scarica per"

#. Language-menu autonym. Keep this language name written in English.
#: apps/website/src/localization/index.ts
msgid "English"
msgstr "English"

#. Language-menu autonym for the tuteo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (tú)"
msgstr "Español (tú)"

#. Language-menu autonym for the voseo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (vos)"
msgstr "Español (vos)"

#. Language-menu autonym. Keep this language name written in French.
#: apps/website/src/localization/index.ts
msgid "Français"
msgstr "Français"

#: apps/website/src/localization/index.ts
msgid "It's 100% private"
msgstr "È 100% privato"

#. Language-menu autonym. Keep this language name written in Italian.
#: apps/website/src/localization/index.ts
msgid "Italiano"
msgstr "Italiano"

#: apps/website/src/localization/index.ts
msgid "It’s free and open source"
msgstr "È gratuito e open source"

#: apps/website/src/localization/index.ts
msgid "Made by"
msgstr "Creato da"

#: apps/website/src/localization/index.ts
msgid "Open a site"
msgstr "Apri un sito"

#: apps/website/src/localization/index.ts
msgid "Pause before visiting addictive websites"
msgstr "Fai una pausa prima di visitare siti che creano dipendenza"

#: apps/website/src/localization/index.ts
msgid "If you feel like it, pick different days and times for each site."
msgstr "Se ti va, scegli giorni e orari diversi per ogni sito."

#. Language-menu autonym for Brazilian Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Brasil)"
msgstr "Português (Brasil)"

#. Language-menu autonym for European Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Portugal)"
msgstr "Português (Portugal)"

#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Privacy"

#: apps/website/src/localization/index.ts
msgid "Privacy policy"
msgstr "Informativa sulla privacy"

#: apps/website/src/localization/index.ts
msgid "Set a schedule for each site"
msgstr "Imposta un orario per ogni sito"

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Vai al contenuto"

#: apps/website/src/localization/index.ts
msgid "Source code"
msgstr "Codice sorgente"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "TOCus aggiunge una pausa per respirare ai siti web che scegli."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus è un’estensione del browser open source."

#: apps/website/src/localization/index.ts
msgid "Take a moment to pause."
msgstr "Prenditi un momento di pausa."

#: apps/website/src/localization/index.ts
msgid "Use it only when you want to"
msgstr "Usalo solo quando vuoi"

#: apps/website/src/localization/index.ts
msgid "Videos pause while you wait and resume when you’re ready."
msgstr "I video si fermano mentre aspetti e riprendono quando vuoi continuare."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Visualizza il codice sorgente"

#: apps/website/src/localization/index.ts
msgid "View your completed pauses and visits you changed your mind about."
msgstr "Consulta le pause completate e le visite a cui hai rinunciato."

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Lingua del sito"

#: apps/website/src/localization/index.ts
msgid "Works with"
msgstr "Funziona con"

#: apps/website/src/localization/index.ts
msgid "You can read the code, suggest changes, or make it your own. There’s no advertising."
msgstr "Puoi leggere il codice, suggerire modifiche o adattarlo come preferisci. Non c’è pubblicità."

#: apps/website/src/localization/index.ts
msgid "Your settings and stats stay in your browser. It even works offline and needs no account."
msgstr "Le tue impostazioni e statistiche restano nel browser. Funziona anche offline e non richiede un account."

#: apps/website/src/localization/index.ts
msgid "Your videos will pause automatically"
msgstr "I tuoi video si fermeranno automaticamente"

#. Language-menu autonym. Keep this language name written in Russian.
#: apps/website/src/localization/index.ts
msgid "Русский"
msgstr "Русский"

#. Language-menu autonym. Keep this language name written in Japanese.
#: apps/website/src/localization/index.ts
msgid "日本語"
msgstr "日本語"
