#: apps/website/src/localization/index.ts
msgid "TOCus adds a gentle breathing pause before the websites you choose, helping you browse more intentionally."
msgstr "TOCus introduce una breve pausa per respirare prima dei siti web che scegli, aiutandoti a navigare con più consapevolezza."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus è un’estensione del browser open source."

#: apps/website/src/localization/index.ts
msgid "TOCus works entirely on your device and will stay that way. No accounts, servers, tracking, browsing-history analysis, or external network requests."
msgstr "TOCus funziona interamente sul tuo dispositivo e continuerà a farlo. Nessun account, server, tracciamento, analisi della cronologia di navigazione o richiesta di rete esterna."

