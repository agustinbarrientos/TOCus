#: apps/website/src/localization/index.ts
msgid "A calmer moment before the next click."
msgstr "Un momento più tranquillo prima del prossimo clic."

#: apps/website/src/localization/index.ts
msgid "Early development"
msgstr "Sviluppo iniziale"

#: apps/website/src/localization/index.ts
msgid "Explore the source on GitHub"
msgstr "Esplora il codice sorgente su GitHub"

#: apps/website/src/localization/index.ts
msgid "Open-source browser extension"
msgstr "Estensione open source per browser"

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension in early development."
msgstr "TOCus è un'estensione open source per browser nelle prime fasi di sviluppo."

#: apps/website/src/localization/index.ts
msgid "TOCus is in early development, exploring a simple pause that supports more intentional browsing."
msgstr "TOCus è nelle prime fasi di sviluppo e sperimenta una semplice pausa per favorire una navigazione più consapevole."

#: apps/website/src/localization/index.ts
msgid "TOCus v1 is local-only: no account, TOCus server, telemetry or product analytics, browsing-history analysis, or network requests for core operation."
msgstr "TOCus v1 funziona solo in locale: nessun account o server TOCus, nessuna telemetria o analisi del prodotto, nessuna analisi della cronologia di navigazione e nessuna richiesta di rete per il funzionamento principale."

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Lingua del sito"
