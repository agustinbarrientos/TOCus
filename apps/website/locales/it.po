#: apps/website/src/localization/index.ts
msgid "10s pause"
msgstr "Pausa di 10 s"

#: apps/website/src/localization/index.ts
msgid "5m browsing"
msgstr "5 min di navigazione"

#: apps/website/src/localization/index.ts
msgid "A calmer way to browse"
msgstr "Un modo più tranquillo di navigare"

#: apps/website/src/localization/index.ts
msgid "Also available on"
msgstr "Disponibile anche per"

#: apps/website/src/localization/index.ts
msgid "Choose different active days and hours for each website."
msgstr "Scegli giorni e orari di attività diversi per ogni sito."

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "Prossimamente"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "Continua"

#: apps/website/src/localization/index.ts
msgid "Custom schedules for each site"
msgstr "Orari personalizzati per ogni sito"

#. Language-menu autonym. Keep this language name written in German.
#: apps/website/src/localization/index.ts
msgid "Deutsch"
msgstr "Deutsch"

#: apps/website/src/localization/index.ts
msgid "Download for"
msgstr "Scarica per"

#. Language-menu autonym. Keep this language name written in English.
#: apps/website/src/localization/index.ts
msgid "English"
msgstr "English"

#. Language-menu autonym for the tuteo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (tú)"
msgstr "Español (tú)"

#. Language-menu autonym for the voseo variant. Keep this language name written in Spanish.
#: apps/website/src/localization/index.ts
msgid "Español (vos)"
msgstr "Español (vos)"

#: apps/website/src/localization/index.ts
msgid "Example: 24h 40m reclaimed / 254 reconsidered visits"
msgstr "Esempio: 24 h 40 min recuperati / 254 visite ripensate"

#. Language-menu autonym. Keep this language name written in French.
#: apps/website/src/localization/index.ts
msgid "Français"
msgstr "Français"

#: apps/website/src/localization/index.ts
msgid "Free and open source"
msgstr "Gratuito e open source"

#: apps/website/src/localization/index.ts
msgid "How it works"
msgstr "Come funziona"

#. Language-menu autonym. Keep this language name written in Italian.
#: apps/website/src/localization/index.ts
msgid "Italiano"
msgstr "Italiano"

#: apps/website/src/localization/index.ts
msgid "Made by"
msgstr "Creato da"

#: apps/website/src/localization/index.ts
msgid "Only when you want"
msgstr "Solo quando vuoi"

#: apps/website/src/localization/index.ts
msgid "Open a site"
msgstr "Apri un sito"

#: apps/website/src/localization/index.ts
msgid "Pause before visiting addictive websites"
msgstr "Fai una pausa prima di visitare siti che creano dipendenza"

#. Language-menu autonym for Brazilian Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Brasil)"
msgstr "Português (Brasil)"

#. Language-menu autonym for European Portuguese. Keep this language name written in Portuguese.
#: apps/website/src/localization/index.ts
msgid "Português (Portugal)"
msgstr "Português (Portugal)"

#: apps/website/src/localization/index.ts
msgid "Privacy"
msgstr "Privacy"

#: apps/website/src/localization/index.ts
msgid "Privacy policy"
msgstr "Informativa sulla privacy"

#: apps/website/src/localization/index.ts
msgid "Read the code, suggest changes, or make it your own. No advertising."
msgstr "Leggi il codice, suggerisci modifiche o adattalo come preferisci. Senza pubblicità."

#: apps/website/src/localization/index.ts
msgid "See completed pauses and reconsidered visits."
msgstr "Consulta le pause completate e le visite ripensate."

#: apps/website/src/localization/index.ts
msgid "See how much time you saved"
msgstr "Scopri quanto tempo hai risparmiato"

#: apps/website/src/localization/index.ts
msgid "Set the days and hours TOCus is active."
msgstr "Imposta i giorni e le ore in cui TOCus è attivo."

#: apps/website/src/localization/index.ts
msgid "Settings and statistics stay in your browser. Works offline, without an account."
msgstr "Le impostazioni e le statistiche restano nel tuo browser. Funziona offline, senza account."

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Vai al contenuto"

#: apps/website/src/localization/index.ts
msgid "Source"
msgstr "Codice sorgente"

#: apps/website/src/localization/index.ts
msgid "Stored on your device"
msgstr "Dati salvati sul tuo dispositivo"

#: apps/website/src/localization/index.ts
msgid "TOCus adds a breathing pause to the websites you choose."
msgstr "TOCus aggiunge una pausa per respirare ai siti web che scegli."

#: apps/website/src/localization/index.ts
msgid "TOCus is an open-source browser extension."
msgstr "TOCus è un’estensione del browser open source."

#: apps/website/src/localization/index.ts
msgid "Take a little pause."
msgstr "Fai una piccola pausa."

#: apps/website/src/localization/index.ts
msgid "Videos pause during the wait and resume when you continue."
msgstr "I video si fermano durante l’attesa e riprendono quando continui."

#: apps/website/src/localization/index.ts
msgid "View the source"
msgstr "Visualizza il codice sorgente"

#: apps/website/src/localization/index.ts
msgid "Website language"
msgstr "Lingua del sito"

#: apps/website/src/localization/index.ts
msgid "YouTube, Netflix, Twitch and more"
msgstr "YouTube, Netflix, Twitch e altri"

#: apps/website/src/localization/index.ts
msgid "Your video pauses, too"
msgstr "Anche il tuo video va in pausa"

