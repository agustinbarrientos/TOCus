msgid "Six palettes with light, dark, or system appearance. Motion follows your operating system's reduced motion setting."
msgstr "Sei palette con aspetto chiaro, scuro o di sistema. Le animazioni seguono l'impostazione di riduzione del movimento del sistema operativo."

#: apps/website/src/localization/index.ts
msgid "Skip to content"
msgstr "Vai al contenuto"

#: apps/website/src/localization/index.ts
msgid "Slow days"
msgstr "Giorni tranquilli"

#: apps/website/src/localization/index.ts
msgid "Space"
msgstr "Spazio"

#: apps/website/src/localization/index.ts
msgid "Statistics"
msgstr "Statistiche"

#: apps/website/src/localization/index.ts
msgid "Stored on your device"
msgstr "Dati salvati sul tuo dispositivo"

#: apps/website/src/localization/index.ts
msgid "Support"
msgstr "Assistenza"

#: apps/website/src/localization/index.ts
msgid "Take a moment"
