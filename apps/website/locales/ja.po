#: apps/website/src/localization/index.ts
msgid "10s pause"
msgstr "10秒の一時停止"

#: apps/website/src/localization/index.ts
msgid "5m browsing"
msgstr "5分のブラウジング"

#: apps/website/src/localization/index.ts
msgid "A calmer way to browse"
msgstr "もっと穏やかなブラウジングを"

#: apps/website/src/localization/index.ts
msgid "Also available on"
msgstr "こちらのブラウザでも利用可能"

#: apps/website/src/localization/index.ts
msgid "Choose different active days and hours for each website."
msgstr "サイトごとに有効な曜日と時間帯を選べます。"

#: apps/website/src/localization/index.ts
msgid "Coming soon"
msgstr "近日公開"

#: apps/website/src/localization/index.ts
msgid "Continue"
msgstr "続ける"

#: apps/website/src/localization/index.ts
msgid "Custom schedules for each site"
msgstr "サイトごとのスケジュール"

