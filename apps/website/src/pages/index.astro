---
import '@tocus/theme/index.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light dark" />
		<meta name="description" content="TOCus is an open-source browser extension in early development." />
		<title>TOCus</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="site-header">
				<p class="wordmark">TOCus</p>
				<p class="status">Early development</p>
			</header>

			<main>
				<article class="hero" aria-labelledby="page-title">
					<p class="eyebrow">Open-source browser extension</p>
					<h1 id="page-title">TOCus</h1>
					<p class="intro">A calmer moment before the next click.</p>
					<p class="description">TOCus is in early development, exploring a simple pause that supports more intentional browsing.</p>
					<a class="source-link" href="https://github.com/agustinbarrientos/TOCus">
						Explore the source on GitHub
						<span aria-hidden="true">&#8599;</span>
					</a>
				</article>
			</main>

			<footer>
				<p>TOCus v1 is local-only: no account, TOCus server, telemetry or product analytics, browsing-history analysis, or network requests for core operation.</p>
			</footer>
		</div>
	</body>
</html>
