---
import HomePage from '../components/home-page/index.astro';
import {
	WebsiteLanguage,
	getWebsiteLocalization,
	getWebsiteLocalizations,
	type LocalizedWebsitePageProperties as Props,
} from '../localization';

/**
 * Generates one static route for every non-English website language.
 * @return Astro route parameters and stable language properties.
 * @since 0.1.0 Initial implementation.
 */
export function getStaticPaths() {
	return getWebsiteLocalizations()
		.filter( ( localization ) => localization.language !== WebsiteLanguage.ENGLISH )
		.map( ( localization ) => ( {
			params: { language: localization.path.slice( 1, -1 ) },
			props: { language: localization.language },
		} ) );
}

const { language } = Astro.props;
const localization = getWebsiteLocalization( language );
const localizations = getWebsiteLocalizations();
---

<HomePage {localization} {localizations} />
