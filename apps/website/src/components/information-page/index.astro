---
import '@tocus/ui/styles.scss';
import '../../styles/global.scss';
import './style.scss';
import InformationPage from './page';
import Favicon from '../favicon/index.astro';
import SocialMetadata from '../social-metadata/index.astro';
import { WebsiteLanguage, getWebsiteLocalization, getWebsiteLocalizations } from '../../localization';
import { InformationPageMetadata, type InformationPageProperties as Props } from './types';

const { document } = Astro.props;
const metadata = InformationPageMetadata[ document ];
const localization = getWebsiteLocalization( WebsiteLanguage.ENGLISH );
const localizations = getWebsiteLocalizations();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light" />
		<meta name="description" content={metadata.description} />
		<SocialMetadata language={localization.language} title={metadata.title}
			description={metadata.description} imageAlt={localization.catalog.intro} />
		<Favicon />
		<title>{metadata.title}</title>
	</head>
	<body>
		<InformationPage {document} {localization} {localizations} client:load />
	</body>
</html>
