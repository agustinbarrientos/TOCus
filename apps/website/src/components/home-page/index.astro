---
import '@tocus/ui/styles.scss';
import '../../styles/global.scss';
import HomePage from './page';
import { type LocalizedHomePageProperties as Props } from '../../localization';
import { loadLocalizationMessages } from '../../../../extension/src/localization/services/load-localization-messages';

const { localization, localizations } = Astro.props;
const { catalog } = localization;
const demoMessages = await loadLocalizationMessages( localization.language );
---

<!doctype html>
<html lang={localization.languageTag}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light" />
		<meta name="description" content={catalog.metadata.description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`TOCus · ${catalog.intro}`} />
		<meta property="og:description" content={catalog.description} />
		<meta property="og:image" content="/images/mascot-peek.webp" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{`TOCus — ${catalog.intro}`}</title>
		<link rel="alternate" hreflang="x-default" href="/" />
		{localizations.map( ( option ) => (
			<link rel="alternate" hreflang={option.languageTag} href={option.path} />
		) )}
	</head>
	<body>
		<HomePage localization={localization} localizations={localizations} demoMessages={demoMessages} client:load />
	</body>
</html>
