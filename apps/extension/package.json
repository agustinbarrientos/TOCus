{
	"name": "@tocus/extension",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A gentle pause before distracting websites, designed to help you return to your intentions.",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build -b chrome",
		"build:firefox": "wxt build -b firefox",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "tsc --noEmit && lit-analyzer \"src/**/*.ts\" --strict --maxWarnings 0",
		"test:browser": "web-test-runner --config config/wtr/web-test-runner.config.js",
		"test:browser:update-screenshots": "web-test-runner --config config/wtr/web-test-runner.config.js --update-snapshots",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@tocus/theme": "workspace:*",
		"lit": "3.3.3"
	},
	"devDependencies": {
		"@open-wc/testing": "5.0.0",
		"@types/mocha": "10.0.10",
		"@web/dev-server-esbuild": "2.0.0",
		"@web/test-runner": "1.0.0",
		"@web/test-runner-commands": "1.0.1",
		"@web/test-runner-playwright": "1.0.0",
		"@web/test-runner-visual-regression": "1.0.1",
		"lit-analyzer": "2.0.3",
		"playwright": "1.62.1",
		"typescript": "6.0.3",
		"vite": "8.2.2",
		"wxt": "0.21.4"
	}
}
