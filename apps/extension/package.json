{
	"name": "@tocus/extension",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A gentle pause before distracting websites, designed to help you return to your intentions.",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build -b chrome",
		"build:firefox": "wxt build -b firefox",
		"build:safari": "wxt build -b safari",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "tsc --noEmit",
		"test:browser": "web-test-runner --config config/wtr/web-test-runner.config.js",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@lingui/core": "6.6.0",
		"@tocus/theme": "workspace:*",
		"@tocus/ui": "workspace:*",
		"@webcomponents/custom-elements": "1.6.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tldts": "7.4.11",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@esm-bundle/chai": "4.3.4-fix.0",
		"@types/mocha": "10.0.10",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@web/dev-server-esbuild": "2.0.0",
		"@web/test-runner": "1.0.0",
		"@web/test-runner-commands": "1.0.1",
		"@web/test-runner-playwright": "1.0.0",
		"@wxt-dev/auto-icons": "1.1.2",
		"@wxt-dev/module-react": "1.2.2",
		"axe-core": "4.13.0",
		"esbuild": "0.28.2",
		"playwright": "1.62.1",
		"sharp": "0.35.4",
		"typescript": "6.0.3",
		"vite": "8.2.2",
		"wxt": "0.21.4"
	}
}
