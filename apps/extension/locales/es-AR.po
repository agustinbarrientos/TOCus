#: apps/extension/src/localization/utils/create-onboarding-copy/index.ts
msgid "You can change these choices and fine-tune timing or schedules any time in Settings."
msgstr "Podés cambiar estas opciones y ajustar los tiempos o los horarios cuando quieras en Configuración."

#: apps/extension/src/localization/utils/create-interruption-copy/index.ts
msgid "You can continue when you are ready."
msgstr "Podés continuar cuando estés listo."

#: apps/extension/src/localization/utils/create-onboarding-copy/index.ts
msgid "You're all set"
msgstr "Ya está todo listo"

#: apps/extension/src/localization/utils/create-appearance-copy/index.ts
msgid "Your appearance could not be saved. Your choice is still shown here."
msgstr "No se pudo guardar tu apariencia. La opción que elegiste sigue visible acá."

#: apps/extension/src/localization/utils/create-onboarding-sites-step-copy/index.ts
msgid "Your browser could not request access for that site. Try again."
msgstr "Tu navegador no pudo solicitar acceso a ese sitio. Volvé a intentarlo."

#: apps/extension/src/localization/utils/create-language-screen-copy/index.ts
msgid "Your browser currently selects {name}."
msgstr "Tu navegador elige actualmente {name}."

#: apps/extension/src/localization/utils/create-protected-site-item-copy/index.ts
msgid "Your changes could not be saved. Nothing was replaced."
msgstr "No se pudieron guardar tus cambios. No se reemplazó nada."

#: apps/extension/src/localization/utils/create-onboarding-copy/index.ts
msgid "Your choice could not be saved. Try again."
msgstr "No se pudo guardar tu elección. Volvé a intentarlo."

#: apps/extension/src/localization/utils/create-onboarding-copy/index.ts
msgid "Your choices and statistics stay on this device. TOCus never reads your browsing history."
msgstr "Tus elecciones y estadísticas permanecen en este dispositivo. TOCus nunca lee tu historial de navegación."

#: apps/extension/src/localization/utils/create-language-screen-copy/index.ts
msgid "Your language could not be saved. TOCus returned to your previous language."
msgstr "No se pudo guardar el idioma. TOCus volvió al idioma anterior."

#: apps/extension/src/localization/utils/create-appearance-copy/index.ts
#: apps/extension/src/localization/utils/create-language-screen-copy/index.ts
msgid "Your local personalization data is not valid. Restoring defaults will reset appearance, pause, motion, and language preferences."
msgstr "Tus datos locales de personalización no son válidos. Restaurar los valores predeterminados restablecerá tus preferencias de apariencia, pausa, movimiento e idioma."

#: apps/extension/src/localization/utils/create-schedule-copy/index.ts
msgid "Your local settings need attention"
msgstr "Tu configuración local necesita atención"

#: apps/extension/src/localization/utils/create-schedule-copy/index.ts
msgid "Your local settings were not changed. Try loading them again."
msgstr "Tu configuración local no cambió. Probá volver a cargarla."

#: apps/extension/src/localization/utils/create-timing-copy/index.ts
msgid "Your local timing data is not valid, so it was not replaced."
msgstr "Tus datos locales de tiempos no son válidos, por eso no se reemplazaron."

#: apps/extension/src/localization/utils/create-protected-sites-copy/index.ts
msgid "Your local website list is not valid, so it was not replaced."
msgstr "Tu lista local de sitios no es válida, así que no se reemplazó."

#: apps/extension/src/localization/utils/create-interruption-copy/index.ts
msgid "Your pause has resumed."
msgstr "Tu pausa se reanudó."

#: apps/extension/src/localization/utils/create-interruption-copy/index.ts
msgid "Your pause has started."
msgstr "Tu pausa empezó."

#: apps/extension/src/localization/utils/create-interruption-copy/index.ts
msgid "Your pause is paused."
msgstr "Tu pausa está detenida."

#: apps/extension/src/localization/utils/create-popup-copy/index.ts
msgid "Your settings and statistics stay on this device."
msgstr "Tu configuración y tus estadísticas quedan en este dispositivo."

#: apps/extension/src/localization/utils/create-statistics-copy/index.ts
msgid "Your statistics stay on this device."
msgstr "Tus estadísticas quedan en este dispositivo."

#: apps/extension/src/localization/utils/create-statistics-copy/index.ts
msgid "Your statistics will start over from zero. Websites, schedules, timing, and appearance remain unchanged."
msgstr "Tus estadísticas van a volver a empezar de cero. Los sitios, los horarios, los tiempos y la apariencia no van a cambiar."

#: apps/extension/src/localization/utils/create-timing-copy/index.ts
msgid "Your timing data changed. Retry before saving these choices."
msgstr "Tus datos de tiempos cambiaron. Volvé a intentarlo antes de guardar estas opciones."

#: apps/extension/src/localization/utils/create-protected-page-layer-copy/index.ts
msgid "Your visit window is ending soon."
msgstr "Tu tiempo de visita está por terminar."

#: apps/extension/src/localization/utils/create-protected-sites-copy/index.ts
msgid "Your website list changed. Retry before adding this site."
msgstr "Tu lista de sitios cambió. Volvé a intentarlo antes de agregar este sitio."

#: apps/extension/src/localization/utils/create-protected-sites-copy/index.ts
msgid "Your website list needs attention"
msgstr "Tu lista de sitios necesita atención"

