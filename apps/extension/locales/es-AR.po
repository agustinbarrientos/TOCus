#: apps/extension/src/localization/utils/create-timing-copy/index.ts
msgid "Wait for an explicit choice before opening the site."
msgstr "Esperá una decisión explícita antes de abrir el sitio."

#: apps/extension/src/localization/utils/create-timing-copy/index.ts
msgid "Wait increase"
msgstr "Aumento de la espera"

#: apps/extension/src/localization/utils/create-timing-copy/index.ts
msgid "Waits start at {initialWait}. Each completed wait adds {waitIncrease} to the next wait, up to {maximumWait}. Completing a wait starts an allowance for {allowance} and opens the site automatically."
msgstr "Las esperas empiezan en {initialWait}. Cada espera completada suma {waitIncrease} a la siguiente, hasta {maximumWait}. Al completar una espera, empieza un tiempo de acceso de {allowance} y el sitio se abre automáticamente."

#: apps/extension/src/localization/utils/create-timing-copy/index.ts
msgid "Waits start at {initialWait}. Each completed wait adds {waitIncrease} to the next wait, up to {maximumWait}. Completing a wait starts an allowance for {allowance} and shows a Continue button."
msgstr "Las esperas empiezan en {initialWait}. Cada espera completada suma {waitIncrease} a la siguiente, hasta {maximumWait}. Al completar una espera, empieza un tiempo de acceso de {allowance} y aparece el botón Continuar."

